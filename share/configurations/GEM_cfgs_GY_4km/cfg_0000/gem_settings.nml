  LEADFRAC        = 0.         ,
  BETA            = 1.0        ,
  Z0TLAT          = 25., 30.   ,
  LIMSNODP        = .true.     ,
  Read_emis	  = .false.    ,
  SALTY_QSAT      = .true.     ,
  ADJ_I0_SNOW     = .false.    ,
  Z0TTYPE         ='deacu12'   ,
  Z0mtype         ='beljaars'  ,
  Z0seaice        = 5.4e-4     ,
  IMPFLX          = .true.     ,
  Icelac       = .true.        ,
  sl_Lmin_type    = 'sfo'      ,
  sl_diag_type    = 'interp'   ,
  sl_ximax        = 5.         ,
  sl_re2          = 0.10       ,
