&surface_cfgs
  Schmurb                      = 'TEB'                         ,
  Schmsol                      = 'ISBA'                        ,
  Adj_I0_snow                  = .false.                       ,
  Beta                         = 1.0                           ,

  Icelac                       = .true.                        ,
  Icemelt                      = .true.                        ,
  Impflx                       = .false.                       ,
  Isba_melting_fix             = .true.                        ,
  Leadfrac                     = 0.                            ,
  Limsnodp                     = .true.                        ,
  Salty_qsat                   = .true.                        ,
  Tdiaglim                     = .true.                        ,
  Urb_diagtemp                 = .true.                        ,
  Urb_diagwind                 = .true.                        ,
  Veg_RS_Mult                  = 2.0	                       ,
  Z0tlat                       = 25., 30.                      ,
  Z0ttype                      = 'deacu12'                     ,
/

&convection_cfgs
  Deep         = 'kfc'         ,
  Kfcdepth     = 2000.         ,
  Kfcrad       = 500.          ,
  Kfctrig4     = 0.,0.,0.5,0.5 ,
  Cmt_type     = 'NIL'         ,
  Deep_timeconv= '30m'         ,

  Shal         = 'ktrsnt'           ,
  Shal_timeconv= '3h'          
/

&physics_cfgs
  Lhn          = 'IRPCP'       ,
  Lhn_weight   = 0.2           ,
  Lhn_filter   = 3.            ,
  Lhn_start_S  = 'steps,10'    ,
  Lhn_stop_S   = 'steps,360'   ,
  Lhn_ramp_S   = 'steps,10'    ,

  Fluvert      = 'moistke'     ,
  Fnn_mask     = .false.       ,
  Fnn_reduc    = 1.            ,

  Kntrad_S     = '15m'         ,
  Inilwc       = .false.       ,

  Gwdrag       = 'NIL'         ,

  Non_oro      = .false.       ,

  Lmetox       = .false.       ,
  Stratos      = .false.       ,

  Longmel      = 'BLAC62'      ,

  Moyhr        = 6             ,

  Stcond       = 'mp_p3'       ,
  P3_ncat      = 1             ,
  P3_depfact   = 1.0           ,
  P3_subfact   = 1.0           ,
  P3_debug     = .false.       ,
  Mpdiag_for_sfc = .true.      ,

  Pbl_ricrit   = 0.15, 2.      ,
  Pbl_shal     = 'NIL'         ,
  Pbl_moistke_legacy_cloud=.true.,

  Pcptype      = 'bourge'      ,

  Radia        = 'cccmarad'    ,

  Satuco       = .true.        ,

  Tofd         = 'beljaars04'  ,
  Tofd_alpha   = 50.           ,

  Qco2         = 380.0         ,
/
 phystat_dble_l = .true.
 phystat_2d_l = .false.
 phystat_freq_S = '0h'
 phystat_list_s = 'ALLVARS=EDPV'
 phystat_input_l = .false.
 debug_mem_L = .true
 debug_trace_L = .true

