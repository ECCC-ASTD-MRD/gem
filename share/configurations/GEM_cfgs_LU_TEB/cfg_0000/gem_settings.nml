#----------------------------------------------------#
#            sample LAM-2.5km national grid          #
#----------------------------------------------------#

&grid
  Grd_typ_S    = 'LU'          ,
  Grd_ni       = 100           ,  Grd_nj       = 100           ,
  Grd_dx       = 0.0225        ,  Grd_dy       = 0.0225        ,
  Grd_lonr     = 195.6         ,  Grd_latr     = -4.00         ,
  Grd_iref     = 65            ,  Grd_jref     = 70            ,
  Grd_xlon1    = -100.00       ,  Grd_xlat1    = 53.00         ,
  Grd_xlon2    =  -85.00       ,  Grd_xlat2    = 50.00         ,
  Grd_maxcfl   = 2             ,
/

&step
  Fcst_end_S   = '6h'          ,
  Fcst_gstat_S = '1h'          ,
  Step_dt      =  60.          ,
  Fcst_nesdt_S = '12'          ,
/

&dyn_kernel
  Dynamics_hydro_L  = .false.,
  Dynamics_Kernel_S = 'DYNAMICS_FISL_P'
/
  Dynamics_Kernel_S = 'DYNAMICS_FISL_H'

&Adz_cfgs
  Adz_slt_winds = .true.
/

&lam
  Lam_blendoro_L = .false.     ,
  Lam_gbpil_T=3
  Lam_blend_T=3
/

&gem_cfgs_not
  Vtopo_length_S = '1h'
/

&sol
  Sol_type_S = 'ITERATIVE_3D',
  Sol_fgm_eps   = 1.d-05
/

&dyn_fisl
  Cstv_tstr_8 = 240.0      ,
  Schm_itcn   = 2          , 
  Schm_itnlh  = 2          , 
  Schm_wload_L= .true.     ,
  Schm_hzdadw_L   = .true.     , 
  Schm_advec      = 2
/
  Schm_orols_fromgeophy_L = .true.

 &hvdif
  Hzd_pwr         = 2          , 
  Hzd_lnr         = 0.4        ,
  Hzd_pwr_theta   = 6          , 
  Hzd_lnr_theta   = 0.02       ,

  Vspng_coeftop   = 67000.     , 
  Vspng_nk        = 0           ,
/   

