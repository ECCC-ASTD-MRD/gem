&inp
  Inp_npes     = 40            ,
/

&out
  Out3_etik_S  = "ret3"        , 

  Out3_lieb_levels=    5000., 4900., 4800., 4700., 4600., 4500.,
                       4400., 4300., 4200., 4100., 4000., 3900.,
                       3800., 3700., 3600., 3500., 3400., 3300.,
                       3200., 3100., 3000., 2900., 2800., 2700.,
                       2600., 2500., 2400., 2300., 2200., 2100.,
                       2000., 1900., 1800., 1700., 1600., 1500.,
                       1400., 1300., 1200., 1100., 1000.,  900.,
                        800.,  700.,  600.,  500.,  400.,  300.,
                        200.,  100.,
 
  Out3_nbitg   = 16            , Out3_cliph_L = .true.    ,
  Out3_linbot  =  3            , Out3_npes=1              ,
  Out3_close_interval_S='1h'   , Out3_postproc_fact=30    ,
  Out3_npex    = -1            , Out3_npey    = -1        ,
/

&surface_cfgs
  Schmurb                      = 'TEB'                         ,
  Schmsol                      = 'SVS'                         ,
  Dp_svs                       = 0.05,0.1,0.2,0.4,1.0,2.0,3.0  ,
  Khyd                         = 6                             ,
  Diusst                       = 'fairall'                     ,
  Diusst_ocean                 = .true.                        ,
  Diusst_lakes                 = .true.                        ,
  Diusst_warmlayer_lakes       = .true.                        ,

  Icelac                       = .true.                        ,
  Icemelt                      = .true.                        ,
  Impflx                       = .true.                        ,
  Leadfrac                     = 0.                            ,
  Limsnodp                     = .true.                        ,
  Read_emis                    = .false.                       ,
  Salty_qsat                   = .true.                        ,
  Sl_func_stab                 = 'beljaars91'                  ,
  Sl_z0ref                     = .true.                        ,
  Sl_lmin_soil                 = 20.                           ,
  Sl_lmin_glacier              = 5.                            ,
  Sl_lmin_water                = 10.                           ,
  Sl_lmin_seaice               = 10.                           ,
  Soiltext                     = 'SOILGRIDS'                   ,
  Svs_hrsurf_method            = 'BETA_ECMWF12'                ,
  Svs_hrsurf_power             = 6.000000                      ,
  Svs_hrsurf_rs                = 50.000000                     ,
  Svs_etr_avg_beta             = .true.                        ,
  Svs_etr_max_roots_ignored    = 0.6000000                     ,
  Svs_local_z0m                = .true.                        ,
  Svs_snow_rain                = 'BELAIR03_DTGEM'              ,
  Tdiaglim                     = .false.                       ,
  Use_eff_surf_tq              = .true.                        ,
  Use_photo                    = .true.                        ,
  Z0mtype                      = 'beljaars'                    ,
  Z0ttype                      = 'deacu12'                     ,
  Z0seaice                     = 5.4e-4                        ,
  Snow_emiss                   = '.97'                         ,
  Ice_emiss                    = '.97'                         ,
  Water_emiss                  = '1.0'                         ,
/
  Svs_gexp                     = 4.000000                      ,

&convection_cfgs
  Deep         = 'kfc2'        ,
  Kfcdepth     = 2000.         ,
  Kfcrad       = 500.          ,
  Kfctrig4     = 0.,0.,0.5,0.5 ,
  Cmt_type     = 'NIL'         ,
  Deep_timeconv= '30m'         ,

  Shal         = 'bechtold'    ,
  Bkf_entrains = 'siebesma03'  ,
  Bkf_detrains = 'cuijpers95'  ,
  Bkf_closures = 'equilibrium' ,
  Bkf_lshalm   = .true.        ,
  Bkf_evaps    = .false.       ,
/

&physics_cfgs
  Lhn          = 'IRPCP'       ,
  Lhn_weight   = 0.2           ,
  Lhn_filter   = 3.            ,
  Lhn_start_S  = 'steps,10'    ,
  Lhn_stop_S   = 'steps,360'   ,
  Lhn_ramp_S   = 'steps,10'    ,

  Fluvert      = 'moistke'     ,
  Fnn_mask     = .false.       ,
  Fnn_reduc    = 1.            ,

  Kntrad_S     = '15m'         ,
  Inilwc       = .false.       ,

  Gwdrag       = 'NIL'         ,

  Non_oro      = .false.       ,

  Lmetox       = .true.        ,
  Stratos      = .true.        ,

  Longmel      = 'BLAC62'      ,

  Moyhr        = 6             ,

  Stcond       = 'mp_p3'       ,
  P3_ncat      = 1             ,
  P3_depfact   = 1.0           ,
  P3_subfact   = 1.0           ,
  P3_debug     = .false.       ,
  Mpdiag_for_sfc = .true.      ,

  Pbl_ricrit   = 0.15, 2.      ,
  Pbl_shal     = 'NIL'         ,
  Pbl_moistke_legacy_cloud=.true.,
  Pbl_mlturb_diss= .true.      ,
  Pbl_tkediff2dt= .true.       ,
  Pbl_diff_condens= .false.    ,
  Pbl_diss     = 'lim50'       ,
  Pbl_zntau    = 900.          ,
  Pbl_dissheat = 'local_k'     ,
  Pbl_cmu_timeavg= .true.      ,

  Pcptype      = 'bourge'      ,

  Radia        = 'cccmarad2'   ,
  Radghg_L     = .true.        ,
  Rad_esfc     = .true.        ,
  Rad_atmpath  = 'LI06'        ,
  Rad_cond_rei = 30.           ,
  Advectke     = .true.        ,
  
  Satuco       = .true.        ,

  Tofd         = 'beljaars04'  ,
  Tofd_alpha   = 50.           ,
/
 phystat_dble_l = .true.
 phystat_2d_l = .false.
 phystat_freq_S = '0h'
 phystat_list_s = 'ALLVARS=EDPV'
 phystat_input_l = .false.
 debug_mem_L = .true
 debug_trace_L = .true

