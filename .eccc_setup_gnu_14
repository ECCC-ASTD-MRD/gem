#!/bin/bash

# Source this file to:
# - Load module for gnu 14 (on science only)
# - Load a script for common setup to all compilers

# We need a more recent version of cmake than the one available by default
. ssmuse-sh -d main/opt/cmake/cmake-3.30.0

export MODULEPATH=~sidr000/modules:$MODULEPATH
module load gcc14
export ORDENV_PLAT=rhel-8-amd64-64
export EC_ARCH=rhel-8-amd-64/gnu-14.1.0
export COMP_ARCH=gnu-14.1.0
export COMPILER_SUITE=gnu
export COMPILER_VERSION=14.1.0

# Load latest version of RPN-SI libraries and utilities
. r.load.dot rpn/libs/20250710
. r.load.dot rpn/utils/20250710
# Load latest version of RPNPY
. r.load.dot rpn/MIG/ENV/rpnpy/2.2.0

# Call common setup file
. ./.common_setup ${COMPILER_SUITE}

# Set WITH_SYSTEM_RPN variable with default value TRUE for ECCC users
export WITH_SYSTEM_RPN=TRUE
