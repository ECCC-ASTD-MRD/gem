      logical cplocn_1st_L,      & ! Only one exchange at start
              cplocn_off_L,      & ! Simulate offline run
              cplocn_bzone_L       ! Activate buffer zone in coupling mask

      integer cplocn_n_fldou, cplocn_n_fldin
      integer cplocn_rap_dt,  cplocn_oc_dt
      integer cplocn_W_chan,  cplocn_R_chan
      integer cplocn_myproc,  cplocn_mycol, cplocn_myrow,  &
              cplocn_mystep,  cplocn_nprocs,               &
              cplocn_atm_nw_max,                           &
              cplocn_gni, cplocn_gnj,                      &
              cplocn_nxchng, cplocn_atm_nxchng,            &
              cplocn_atm_nspread,                          &
              cplocn_dynphy_offset
                         ! Offset between GEM global model grid and physics global grid
                         ! in LAM mode

      real,    parameter :: cplocn_missval=-9999.

      character*16 cplocn_runstrt_S

      parameter (cplocn_n_fldou=10)
      character*3, dimension(cplocn_n_fldou) :: cplocn_cvou_S
      character*1, dimension(cplocn_n_fldou) :: cplocn_cvot_S
      parameter (cplocn_n_fldin=38)
      character*3, dimension(cplocn_n_fldin) :: cplocn_cvin_S
      character*1, dimension(cplocn_n_fldin) :: cplocn_cvit_S

! Atmospheric model sends
      data cplocn_cvou_S /'FBA','FIA','RTA','TTA',            &
                           'UUA','VVA','QQA','PMA','PTA','P0A'/
      data cplocn_cvot_S /'S'  ,'S'  ,'S'  ,'S'  ,            &
                           'U'  ,'V'  ,'S'  ,'S'  ,'S'  ,'S'  /
! Ocean model received
      data cplocn_cvin_S /'MCP','ALO','ALI','T4O','T4I',  &
                          'SHO','SHI','LHO','LHI',        &
                          'TXO','TYO','TXI','TYI',        &
                          'ZTO','ZQO','ZUO','ZVO',        &
                          'ZTI','ZQI','ZUI','ZVI',        &
                          'GLI','I8I','SDI','TMO',        &
                          'UUO','VVO','I7I','UUI','VVI',  &
                          'QSO','QSI','ILO','ILI',        &
                          'ZMO','ZMI','ZHO','ZHI'      /
      data cplocn_cvit_S /'S'  ,'S'  ,'S'  ,'S',  'S'  ,  &
                          'S'  ,'S'  ,'S'  ,'S'  ,        &
                          'U'  ,'V'  ,'U'  ,'V'  ,        &
                          'S'  ,'S'  ,'U'  ,'V'  ,        &
                          'S'  ,'S'  ,'U'  ,'V'  ,        &
                          'S'  ,'S'  ,'S'  ,'S'  ,        &
                          'U'  ,'V'  ,'S'  ,'U'  ,'V',    &
                          'S'  ,'S'  ,'S'  ,'S'  ,        &
                          'S'  ,'S'  ,'S'  ,'S'        /

      common /cplo_L/            &
              cplocn_1st_L,      &
              cplocn_off_L,      &
              cplocn_bzone_L

      common /cplo_I/ cplocn_rap_dt,cplocn_oc_dt,                &
                      cplocn_W_chan,cplocn_R_chan,               &
                      cplocn_myproc,cplocn_mycol,cplocn_myrow,   &
                      cplocn_mystep,cplocn_nprocs,               &
                      cplocn_atm_nw_max,                         &
                      cplocn_gni,cplocn_gnj,                     &
                      cplocn_nxchng,cplocn_atm_nxchng,           &
                      cplocn_atm_nspread, cplocn_dynphy_offset
 
      common /cpl_S/ cplocn_runstrt_S
      
      real, dimension (:,:,:),   pointer :: ocn_busou

! Local versions of interpolation weight structure
!  (ocn_iwgt and ocn_jwgt re-distributed to proc zero, hence 4th dim = cplocn_nprocs)
      integer,dimension (:,:,:),   pointer :: ocn_iwgt   ! Ice/ocean model i weight indices
      integer,dimension (:,:,:),   pointer :: ocn_jwgt   ! Ice/ocean model j weight indices
      integer,dimension (:,:),     pointer :: ocn_mwgt   ! Mask coherent with weights
      integer,dimension (:,:),     pointer :: ocn_cwgt   ! Number of valid weights
      real*8, dimension (:,:,:),   pointer :: ocn_wgt    ! Weights in the world of GEM
      real,   dimension (:,:),     pointer :: ocn_awgt   ! Ice/ocean grid angle
                                                         ! to rotate vectors (degrees)
      real,   dimension (:,:),     pointer :: ocn_sint   ! Pre-computed rotation factors
      real,   dimension (:,:),     pointer :: ocn_cost   ! Pre-computed rotation factors
      integer,dimension (:,:),     pointer :: ocn_ijtoc  ! Index: compressed ocn global fields
      integer,dimension (:),       pointer :: atm_ctoi   ! Index: compressed atm global fields
      integer,dimension (:),       pointer :: atm_ctoj   ! Index: compressed atm global fields

      common/cplo_TI/ ocn_iwgt, ocn_jwgt, ocn_mwgt, ocn_cwgt, &
                      ocn_ijtoc,atm_ctoi, atm_ctoj

      common/cplo_TR/ ocn_busou, ocn_sint, ocn_cost
      common/cplo_T8/ ocn_wgt

! GMM access section (busin)
      real, dimension (:,:,:),   pointer :: ocn_busin  => null()
      real, dimension (:,:  ),   pointer :: gli_0      => null()
      real, dimension (:,:  ),   pointer :: i8i_0      => null()
      real, dimension (:,:  ),   pointer :: sdi_0      => null()
      real, dimension (:,:  ),   pointer :: tmo_0      => null()

      character(len=GMM_MAXNAMELENGTH) :: gmmk_ocn_busin_s, &
                              gmmk_gli_0_s, gmmk_i8i_0_s, &
                              gmmk_sdi_0_s, gmmk_tmo_0_s

      common /cplo_S_gmm/ gmmk_ocn_busin_s, &
                          gmmk_gli_0_s, gmmk_i8i_0_s, &
                          gmmk_sdi_0_s, gmmk_tmo_0_s

      integer :: icvin_MCP, icvin_ALO, icvin_ALI,            &
                 icvin_T4O, icvin_T4I, icvin_SHO, icvin_SHI, &
                 icvin_LHO, icvin_LHI, icvin_TXO, icvin_TYO, &
                 icvin_TXI, icvin_TYI, icvin_ZTO, icvin_ZQO, &
                 icvin_ZUO, icvin_ZVO, icvin_ZTI, icvin_ZQI, &
                 icvin_ZUI, icvin_ZVI, icvin_GLI, icvin_I8I, &
                 icvin_SDI, icvin_TMO, icvin_UUO, icvin_VVO, &
                 icvin_I7I, icvin_UUI, icvin_VVI,            &
                 icvin_QSO, icvin_QSI, icvin_ILO, icvin_ILI, &
                 icvin_ZMO, icvin_ZMI, icvin_ZHO, icvin_ZHI
 
      common /cplo_I_gmm/ icvin_MCP, icvin_ALO, icvin_ALI,              &
                          icvin_T4O, icvin_T4I, icvin_SHO, icvin_SHI,   &
                          icvin_LHO, icvin_LHI, icvin_TXO, icvin_TYO,   &
                          icvin_TXI, icvin_TYI, icvin_ZTO, icvin_ZQO,   &
                          icvin_ZUO, icvin_ZVO, icvin_ZTI, icvin_ZQI,   &
                          icvin_ZUI, icvin_ZVI, icvin_GLI, icvin_I8I,   &
                          icvin_SDI, icvin_TMO, icvin_UUO, icvin_VVO,   &
                          icvin_I7I, icvin_UUI, icvin_VVI,              &
                          icvin_QSO, icvin_QSI, icvin_ILO, icvin_ILI,   &
                          icvin_ZMO, icvin_ZMI, icvin_ZHO, icvin_ZHI
